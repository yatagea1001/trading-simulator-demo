€‚␀û…‚␀€␀ƒ€␀,␀ ␀ ␀
 ␀␀␀␀@À␀À␀␀␀␀␀␀`␀␀À␀@␀␀␀␀␀€␀…␀€␀î…␀€Ë␀@ÿn…␀€␀ü€␀␀ş€␀€␀ ␀
 ␀␀␀␀␀␀␀␀`À␀À␀␀␀␀␀␀Ê␀€ş␀…€Ó␀‚…€␀…␀␀û€€␀,␀␀␀␀␀	␀␀␀␀␀@À␀À␀␀␀␀␀␀@␀␀À␀@␀␀␀␀€ë␀œ…€␀6…€Õ␀@ÿ…€␀…€ş␀ù…‚␀…␀€␀ ␀␀␀␀␀␀␀␀␀␀`À␀À␀␀␀␀␀␀€␀…€␀ï…€Ø␀ˆ…€␀…␀␀ı€␀€␀,␀␀␀␀␀␀␀␀␀␀@À␀À␀␀␀␀␀␀`␀␀À␀@␀␀␀␀€À␀›…€"␀M…€ò␀ç…€␀…€ş␀ü…␀␀€#pragma once
#include "imgui.h"
#include "implot.h"
#include <string>
#include <chrono>
#include <cmath>
#include <vector>
#include <iostream>
#include <iomanip>
#include <sstream>
#include <algorithm>
#include <ctime>   
#include "Candle.h" 

// --- GLOBAL STATE VARIABLES ---
static int g_SelectedTradeID = -1; 
static bool g_IsDraggingGlobal = false;

// Helper Format Uang
static std::string FormatUSD(double val) {
    std::stringstream ss;
    ss << std::fixed << std::setprecision(2) << val;
    return ss.str();
}

// Helper Format Waktu
static std::string FormatTime(double timestamp) {
    time_t t = (time_t)timestamp;
    struct tm tm;
    #ifdef _WIN32
        localtime_s(&tm, &t);
    #else
        localtime_r(&t, &tm);
    #endif
    char buf[32];
    strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M", &tm); 
    return std::string(buf);
}

enum TradeType { TRADE_BUY, TRADE_SELL };

// =================================================================================
// CLASS LIVETRADE
// =================================================================================
class LiveTrade {
public:
    int id;
    std::string symbol;
    TradeType type;
    
    // Status
    bool isOpen = true;       
    bool isPending = false;   
    bool isLocked = false; 
    
    // Config
    bool showZones = true; 

    // Harga & Size
    double entryPrice = 0;
    double sl = 0;
    double tp = 0;
    double volume = 0;
    double closePrice = 0;
    double profit = 0;        
    double openTime = 0; 

    // Visual State
    bool draggingEntry = false;
    bool draggingSL = false;
    bool draggingTP = false;
    bool slActive = false;
    bool tpActive = false;

    LiveTrade(int _id, std::string _sym, TradeType _type, double _price, double _vol, double _time, bool _pending)
        : id(_id), symbol(_sym), type(_type), entryPrice(_price), volume(_vol), openTime(_time), isPending(_pending) 
    {
        sl = _price;
        tp = _price;
        slActive = false;
        tpActive = false;
    }

    bool IsDragging() const { return draggingEntry || draggingSL || draggingTP; }

    // =========================================================
    // VISUAL RENDERING
    // =========================================================
    bool RenderVisuals() {
        if (!isOpen) return false;

        ImGui::PushID(id); 

        // 1. Cek Selection State
        bool isSelected = (g_SelectedTradeID == id);
        bool isHoveredAnyComponent = false; 

        ImPlotRect limits = ImPlot::GetPlotLimits();
        ImDrawList* draw = ImPlot::GetPlotDrawList();
        
        // --- LOGIKA OPACITY (TRANSPARANSI) ---
        // Jika Selected: Alpha 1.0 (Jelas)
        // Jika Unselected: Alpha 0.3 (Redup/Ghost)
        float baseAlpha = isSelected ? 1.0f : 0.9f; 

        // Warna Garis & Tombol
        ImVec4 colEntry = (type == TRADE_BUY) ? ImVec4(0.0f, 0.6f, 1.0f, 1.0f) : ImVec4(1.0f, 0.4f, 0.4f, 1.0f);
        ImVec4 colSL    = ImVec4(1.0f, 0.3f, 0.3f, 1.0f); 
        ImVec4 colTP    = ImVec4(0.0f, 0.8f, 0.4f, 1.0f); 

        // Terapkan Alpha
        colEntry.w = baseAlpha;
        colSL.w = baseAlpha;
        colTP.w = baseAlpha;

        // Update Posisi Drag
        if (IsDragging()) {
            UpdateDragPosition();
        }

        // --- 1. GAMBAR ZONE (ARSIR) ---
        // Logic: Tampil SELALU jika showZones aktif.
        // Tapi transparansinya ikut baseAlpha.
        if (showZones) {
            // Kalau Selected: Alpha 0.2 (Jelas tapi transparan)
            // Kalau Unselected: Alpha 0.05 (Sangat tipis biar tidak kotor)
            float zoneAlpha = isSelected ? 0.2f : 0.2f;

            ImVec4 colZoneWin = ImVec4(0.0f, 1.0f, 0.0f, zoneAlpha); 
            ImVec4 colZoneLoss = ImVec4(1.0f, 0.0f, 0.0f, zoneAlpha); 
            
            if (slActive || draggingSL) DrawZone(entryPrice, sl, colZoneLoss); 
            if (tpActive || draggingTP) DrawZone(entryPrice, tp, colZoneWin);  
        }

        // --- 2. GAMBAR GARIS ---
        DrawLine(entryPrice, colEntry, false, draggingEntry, "##EntryLine");
        if (slActive || draggingSL) DrawLine(sl, colSL, true, draggingSL, "##SLLine");
        if (tpActive || draggingTP) DrawLine(tp, colTP, true, draggingTP, "##TPLine");

        // Konektor (Konektor vertikal antar garis)
        if (slActive && tpActive) {
            ImU32 colLine = ImGui::ColorConvertFloat4ToU32(colEntry);
            // Alpha bit mask untuk konektor
            if (!isSelected) colLine = (colLine & 0x00FFFFFF) | ((ImU32)(baseAlpha * 255) << 24);

            ImVec2 pSL = ImPlot::PlotToPixels(ImPlotPoint(limits.X.Max, sl));
            ImVec2 pTP = ImPlot::PlotToPixels(ImPlotPoint(limits.X.Max, tp));
            draw->AddLine(pSL, pTP, colLine, 1.0f); 
        }

        // --- 3. RISK REWARD (RR) ---
        // Tampil SELALU (Ghost Mode kalau unselected)
        DrawRiskReward(draw, limits, baseAlpha);

        // --- 4. DRAW TAGS (BUTTONS) ---
        auto HandleTag = [&](double& val, ImVec4 col, const char* label, bool& draggingFlag, bool isEntry, bool isSmall, float offX) {
            bool hovered = false;
            
            // Ceklis Zone Logic
            bool showChecklist = (isEntry && isSelected); // Ceklis tetap hanya muncul kalau selected biar rapi
            
            bool clicked = DrawTag(draw, val, col, label, draggingFlag, isSmall, offX, &hovered, showChecklist ? &showZones : nullptr, baseAlpha);
            
            if (hovered) isHoveredAnyComponent = true;

            if (clicked) {
                if (g_SelectedTradeID != id) {
                    g_SelectedTradeID = id; 
                }
                draggingFlag = true;
                g_IsDraggingGlobal = true;
            }
        };

        std::string labelEntry = (type == TRADE_BUY) ? "BUY #" + std::to_string(id) : "SELL #" + std::to_string(id);
        std::string labelSL = "SL #" + std::to_string(id);
        std::string labelTP = "TP #" + std::to_string(id);

        // ENTRY
        bool visualEntryDrag = draggingEntry; if (!isPending) visualEntryDrag = false; 
        HandleTag(entryPrice, colEntry, labelEntry.c_str(), draggingEntry, true, false, 0);

        // SL
        if (slActive) HandleTag(sl, colSL, labelSL.c_str(), draggingSL, false, false, 0);
        else HandleTag(entryPrice, colSL, "SL", draggingSL, false, true, 120.0f); 

        // TP
        if (tpActive) HandleTag(tp, colTP, labelTP.c_str(), draggingTP, false, false, 0);
        else HandleTag(entryPrice, colTP, "TP", draggingTP, false, true, 160.0f); 

        // --- STOP DRAGGING (MOUSE UP) ---
        if (!ImGui::IsMouseDown(0) && IsDragging()) {
            draggingEntry = draggingSL = draggingTP = false;
            g_IsDraggingGlobal = false;
        }

        ImGui::PopID(); 
        return isHoveredAnyComponent;
    }

    void UpdateLogic(double currentPrice, double contractSize) {
        if (!isOpen) return;
        double diff = (type == TRADE_BUY) ? (currentPrice - entryPrice) : (entryPrice - currentPrice);
        profit = diff * volume * contractSize;
        if (IsDragging()) return; 

        if (type == TRADE_BUY) {
            if (slActive && sl > 0 && currentPrice <= sl) Close(sl, "Hit SL");
            else if (tpActive && tp > 0 && currentPrice >= tp) Close(tp, "Hit TP");
        } else {
            if (slActive && sl > 0 && currentPrice >= sl) Close(sl, "Hit SL");
            else if (tpActive && tp > 0 && currentPrice <= tp) Close(tp, "Hit TP");
        }
    }

    void CheckHitCandle(const Candle& cd, double contractSize) {
        if (!isOpen || IsDragging()) return;
        bool closedNow = false; double closeP = 0;
        if (type == TRADE_BUY) {
            if (slActive && cd.low <= sl) { closedNow = true; closeP = sl; }
            else if (tpActive && cd.high >= tp) { closedNow = true; closeP = tp; }
        } else {
            if (slActive && cd.high >= sl) { closedNow = true; closeP = sl; }
            else if (tpActive && cd.low <= tp) { closedNow = true; closeP = tp; }
        }
        if (closedNow) Close(closeP, "Candle Hit");
    }

    void Close(double price, const char* reason) {
        isOpen = false;
        closePrice = price;
    }

private:
    void UpdateDragPosition() {
        ImPlotPoint mousePlot = ImPlot::GetPlotMousePos();
        if (draggingEntry && isPending) entryPrice = mousePlot.y;
        if (draggingSL) { sl = mousePlot.y; slActive = true; }
        if (draggingTP) { tp = mousePlot.y; tpActive = true; }
    }

    void DrawZone(double price1, double price2, ImVec4 color) {
        ImPlotRect limits = ImPlot::GetPlotLimits();
        double xs[2] = { limits.X.Min, limits.X.Max };
        double ys1[2] = { price1, price1 };
        double ys2[2] = { price2, price2 };
        ImPlot::SetNextFillStyle(color);
        ImPlot::PlotShaded(("##Zone" + std::to_string(price2)).c_str(), xs, ys1, ys2, 2);
    }

    void DrawLine(double y, ImVec4 color, bool isDashed, bool isThick, const char* labelId) {
        ImPlotRect limits = ImPlot::GetPlotLimits();
        double xs[2] = { limits.X.Min, limits.X.Max };
        double ys[2] = { y, y };
        float alpha = isThick ? 1.0f : (isDashed ? 0.8f : 1.0f);
        // Alpha dari parameter color sudah diatur di RenderVisuals
        ImPlot::SetNextLineStyle(color, isThick ? 2.5f : 1.5f);
        ImPlot::PlotLine(labelId, xs, ys, 2);
    }

    // ğŸ”¥ MODIFIED: DRAW RISK REWARD (Accepts Alpha)
    void DrawRiskReward(ImDrawList* draw, ImPlotRect limits, float alpha) {
        if (!slActive || !tpActive) return;
        double risk = fabs(entryPrice - sl); 
        double reward = fabs(tp - entryPrice);
        if (risk < 0.00001) return;
        double ratio = reward/risk;
        char buf[64]; sprintf(buf, "RR 1:%.2f", ratio);
        
        float fontScale = (draggingSL || draggingTP) ? 1.4f : 1.0f; 
        
        ImGui::SetWindowFontScale(fontScale);
        ImVec2 txtSz = ImGui::CalcTextSize(buf);
        ImGui::SetWindowFontScale(1.0f); 
        ImVec2 pos = ImPlot::PlotToPixels(ImPlotPoint(limits.X.Max, entryPrice));
        float offsetFromAxis = 126.0f; 
        float boxRight = pos.x - offsetFromAxis;
        float boxLeft = boxRight - txtSz.x - 20.0f;
        float halfHeight = (txtSz.y * 0.5f) + 6.0f;
        ImVec2 bgMin = ImVec2(boxLeft, pos.y - halfHeight);
        ImVec2 bgMax = ImVec2(boxRight, pos.y + halfHeight);
        ImVec2 txtPos = ImVec2(bgMin.x + 10.0f, bgMin.y + 6.0f);

        // Alpha blended colors
        // Text: Gold (255, 215, 0)
        ImU32 colText = IM_COL32(255, 215, 0, (int)(255 * alpha)); 
        // Bg: Dark (20, 20, 20)
        ImU32 colBg = IM_COL32(20, 20, 20, (int)(230 * alpha));    
        
        draw->AddRectFilled(bgMin, bgMax, colBg, 4.0f);
        draw->AddRect(bgMin, bgMax, colBg, 4.0f); 
        draw->AddText(ImGui::GetFont(), ImGui::GetFontSize() * fontScale, txtPos, colText, buf);
    }

    // ğŸ”¥ MODIFIED: DRAW TAG (Accepts Alpha)
    bool DrawTag(ImDrawList* draw, double yValue, ImVec4 color, const char* label, bool isDragging, bool isSmall, float offX, bool* outHovered, bool* pShowZones, float alpha) {
        ImPlotRect limits = ImPlot::GetPlotLimits();
        ImVec2 pos = ImPlot::PlotToPixels(ImPlotPoint(limits.X.Max, yValue));
        
        char buf[64];
        if (isSmall) sprintf(buf, "%s", label); else sprintf(buf, "%s %.2f", label, yValue); 
        
        ImGui::SetWindowFontScale(1.0f);
        ImVec2 txtSz = ImGui::CalcTextSize(buf);
        
        float checkSize = 10.0f;
        float gap = 5.0f;
        float totalWidth = txtSz.x;
        if (pShowZones) totalWidth += checkSize + gap;

        float pad = isDragging ? 8.0f : 6.0f;
        float rightAnchor = pos.x - (isSmall ? offX : 0); 
        ImVec2 min = ImVec2(rightAnchor - totalWidth - (pad*2), pos.y - txtSz.y/2 - 4);
        ImVec2 max = ImVec2(rightAnchor, pos.y + txtSz.y/2 + 4);
        
        bool hov = ImGui::IsMouseHoveringRect(min, max);
        if (outHovered && hov) *outHovered = true;

        bool clk = false;
        if (hov) {
            ImGui::SetMouseCursor(ImGuiMouseCursor_Hand);
            if (ImGui::IsMouseClicked(0)) {
                 clk = true;
            }
        }

        // Apply Alpha to Background
        ImU32 bgCol = IM_COL32(20, 20, 20, (int)(240 * alpha));
        draw->AddRectFilled(min, max, bgCol, 4);
        
        float borderThick = hov || isDragging ? 2.0f : 1.0f;
        // Color sudah membawa alpha dari RenderVisuals
        draw->AddRect(min, max, ImGui::ColorConvertFloat4ToU32(color), 4, 0, borderThick);

        float textOffsetX = min.x + pad;
        
        // Render Ceklis
        if (pShowZones) {
            ImVec2 checkMin = ImVec2(textOffsetX, pos.y - checkSize/2);
            ImVec2 checkMax = ImVec2(checkMin.x + checkSize, checkMin.y + checkSize);
            
            bool hovCheck = ImGui::IsMouseHoveringRect(checkMin, checkMax);
            if (hovCheck && ImGui::IsMouseClicked(0)) {
                *pShowZones = !(*pShowZones); 
                clk = false; 
            }

            ImU32 colCheck = *pShowZones ? IM_COL32(0, 255, 0, 255) : IM_COL32(100, 100, 100, 255);
            draw->AddRectFilled(checkMin, checkMax, colCheck, 2);
            draw->AddRect(checkMin, checkMax, IM_COL32(255,255,255,150), 2);

            textOffsetX += checkSize + gap;
        }

        draw->AddText(ImVec2(textOffsetX, min.y+4), ImGui::ColorConvertFloat4ToU32(color), buf);
        return clk;
    }
};

class TradeManager {
public:
    std::vector<LiveTrade> trades; 
    int nextId = 1;
    double balance = 10000.0;
    double equity = 10000.0;
    const double CONTRACT_SIZE = 100.0; 

    // ğŸ”¥ UPDATE: Tambahkan parameter 'std::string symbol' di depan
    void OpenTrade(std::string symbol, TradeType type, double price, double vol, double time, bool pending) {
        
        // ğŸ”¥ UPDATE: Jangan hardcode "XAUUSD", tapi pakai variabel 'symbol'
        trades.emplace_back(nextId++, symbol, type, price, vol, time, pending);
        
        g_SelectedTradeID = nextId - 1; 
        std::cout << "âœ… Open Trade #" << (nextId-1) << " Pair: " << symbol << std::endl;
    }

    void RenderAllVisuals() {
        bool isAnyTradeHovered = false;

        // Render Background (Unselected)
        for (auto& t : trades) {
            if (t.id != g_SelectedTradeID) {
                bool hovered = t.RenderVisuals();
                if (hovered) isAnyTradeHovered = true;
            }
        }

        // Render Foreground (Selected)
        if (g_SelectedTradeID != -1) {
            for (auto& t : trades) {
                if (t.id == g_SelectedTradeID) {
                    bool hovered = t.RenderVisuals();
                    if (hovered) isAnyTradeHovered = true;
                    break;
                }
            }
        }

        // Global Deselect Logic
        if (ImGui::IsMouseClicked(ImGuiMouseButton_Left) && !g_IsDraggingGlobal && !isAnyTradeHovered && ImPlot::IsPlotHovered()) {
            g_SelectedTradeID = -1;
        }
    }

    void UpdateAllLogic(double currentPrice, double currentTime) {
        double floatingPL = 0.0;
        for (auto& t : trades) {
            t.UpdateLogic(currentPrice, CONTRACT_SIZE);
            if (t.isOpen) floatingPL += t.profit;
        }
        equity = balance + floatingPL;
    }

    void CheckAllHits(const Candle& cd) {
        for (auto& t : trades) {
            bool wasOpen = t.isOpen;
            t.CheckHitCandle(cd, CONTRACT_SIZE);
            if (wasOpen && !t.isOpen) balance += t.profit; 
        }
    }
    
    void CloseTrade(int id, double price) {
        for (auto& t : trades) {
            if (t.id == id && t.isOpen) {
                t.Close(price, "Manual Close");
                balance += t.profit;
            }
        }
    }

    void CloseAllSafe(double currentPrice) {
        for (auto& t : trades) {
            if (t.isOpen && !t.isLocked) {
                t.Close(currentPrice, "Close All Button");
                balance += t.profit;
            }
        }
    }
};‰PNG
