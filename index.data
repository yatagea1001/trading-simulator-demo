    double sellVol = 0.0;   // aggressor SELL (side "A" dari Hyperliquid)
};

struct Candle {
    double open   = 0.0;
    double high   = 0.0;
    double low    = 0.0;
    double close  = 0.0;
    std::string datetime;  // misalnya "2025-10-24 10:15"
